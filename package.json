{
	"name": "n8n-nodes-certifier",
	"version": "0.1.2",
	"description": "n8n nodes for Certifier: issue, send and track digital certificates and badges.",
	"license": "MIT",
	"homepage": "https://certifier.io",
	"keywords": [
		"n8n-community-node-package",
		"certifier",
		"certificates",
		"badges",
		"credentials"
	],
	"author": {
		"name": "Certifier",
		"email": "support@certifier.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/certifier-me/n8n-nodes-certifier.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CertifierApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Certifier/Certifier.node.js",
			"dist/nodes/CertifierTrigger/CertifierTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
